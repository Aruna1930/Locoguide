    var status = document.getElementById('uiStatusBox');
    var chat = document.getElementById('uiDialogueFrame');
    var queryIn = document.getElementById('uiQueryInput');
    var askBtn = document.getElementById('uiAskBtn');

    if(code in assets_table) {
        var asset = assets_table[code];
