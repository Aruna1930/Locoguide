    if(!val) return;

    chat.innerHTML += '<div style="background-color: rgba(13, 148, 136, 0.2); border: 1px solid rgba(13, 148, 136, 0.4); padding: 6px; border-radius: 6px; max-width: 90%; margin-left: auto; text-align: right; margin-bottom: 6px;">' + val + '</div>';
