<script>
var assets_table = {
    "LOCO-BRK-2026-001": {
        "serial_number": "LOCO-BRK-2026-001",
        "model_type": "Pneumatic Air-Brake (CCB-2.0)",
        "dispatch_location": "New Delhi (NDLS) Shed",
        "manufacture_date": "2026-09-27",
